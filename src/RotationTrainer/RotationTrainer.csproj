<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <!-- Release version (major.minor.patch); bumped by publish.sh / publish.ps1. -->
    <Version>1.0.5</Version>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DALAMUD_HOME)' != ''">
    <DalamudLibPath>$(DALAMUD_HOME)/</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The plugin icon. Dalamud shows images/icon.png next to the DLL for dev plugins and repo.json links it as
         IconUrl; the embedded copy is the settings window's logo, since the release zip has no images folder. -->
    <Content Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="images\icon.png" LogicalName="RotationTrainer.icon.png" />
    <!-- Rotations every library starts with (see Plugin.BuiltInRotations). -->
    <EmbeddedResource Include="..\..\presets\balance-openers.json" LogicalName="RotationTrainer.presets.json" />
    <EmbeddedResource Include="..\..\presets\levelling-cards.json" LogicalName="RotationTrainer.levelling.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RotationTrainer.Core\RotationTrainer.Core.csproj" />
    <ProjectReference Include="..\RotationTrainer.GameData\RotationTrainer.GameData.csproj" />
  </ItemGroup>

</Project>
